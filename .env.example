NODE_ENV=development
PORT=3000

POSTGRES_USER=neotek
POSTGRES_PASSWORD=change_me
POSTGRES_DB=neotek

# Development Compose exposes PostgreSQL on host port 5433.
DATABASE_URL=postgresql://neotek:change_me@localhost:5433/neotek?schema=public

REDIS_URL=redis://localhost:6379

FRONTEND_URL=http://localhost:5173

# Production requires exact proxy IPs/CIDRs; never true, a hop count, or /0.
# Example only: local reverse proxy on the backend host. Configure actual ranges.
# TRUST_PROXY=127.0.0.1/32,::1/128

# Backend-only Cloudinary credentials. Use a SIGNED upload preset configured
# to allow jpg/jpeg/png/webp/gif/avif images up to 10 MB.
# Set all four values together; when all are absent uploads remain unavailable (503).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# Booking V1. Required before starting the backend; never expose the key to Vite.
# Store a canonical base64 32-byte key in backend secrets before importing
# CustomerModule. Keep it stable while verification deliveries are pending.
CUSTOMER_VERIFICATION_ENCRYPTION_KEY=
# Customer password reset lifetime, 30–60 minutes. Existing encryption key also
# protects reset delivery secrets with a separate authenticated context.
CUSTOMER_PASSWORD_RESET_MINUTES=45
# GIS identity only; no Calendar scopes, client secret or token persistence.
GOOGLE_CUSTOMER_LOGIN_ENABLED=false
GOOGLE_CUSTOMER_CLIENT_ID=
BOOKING_ADMIN_EMAIL=
BOOKING_TIMEZONE=Asia/Ho_Chi_Minh
BOOKING_WORKING_DAYS=1,2,3,4,5
BOOKING_START_MINUTE=480
BOOKING_END_MINUTE=1080
BOOKING_DURATIONS=30,45,60
BOOKING_LEAD_MINUTES=60
BOOKING_HORIZON_DAYS=90
BOOKING_BUFFER_BEFORE=0
BOOKING_BUFFER_AFTER=0
BOOKING_HOLD_MINUTES=10

# disabled: keep durable intents pending (development only).
# dev: deliver private JSON mail files in EMAIL_DEV_DIRECTORY, never in public/.
# resend: real delivery; required in production with a verified sender.
# Set EMAIL_PROVIDER=resend for a real dev-live test; missing key/invalid sender fails startup.
# EMAIL_FROM accepts a verified sender email or Name <email@verified-domain>.
# Resend's onboarding@resend.dev testing sender can send only to your Resend account email.
# Other recipients require your own verified domain. Never commit the real API key.
# EMAIL_REPLY_TO is optional; when configured it must be a valid mailbox.
EMAIL_PROVIDER=disabled
EMAIL_FROM=
EMAIL_REPLY_TO=
RESEND_API_KEY=
EMAIL_DEV_DIRECTORY=
# Optional manual test recipient, never used to redirect customer notifications.
# With EMAIL_PROVIDER=resend and sender/key configured: npm run email:test
# Success means provider acceptance; verify inbox/Resend delivery status separately.
EMAIL_TEST_TO=

# Separate OAuth Web client: NeoTek Calendar Organizer (never VITE_*).
# Enable only after configuring the Calendar API, exact redirect URI and company account.
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/integrations/google/calendar/callback
GOOGLE_CALENDAR_ORGANIZER_EMAIL=
# Independent durable AES-256-GCM key: canonical base64 for 32 random bytes.
# Keep in backend secret environment; losing/changing it requires reconnecting.
GOOGLE_CALENDAR_ENCRYPTION_KEY=hdQ/qaM7klUe0iCoyjln2nX/TgBcD4UZpJ7/wL52qrI=
